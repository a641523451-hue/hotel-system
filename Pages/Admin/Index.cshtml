@page
@model Hotel.Web.Pages.Admin.IndexModel

<link rel="stylesheet" href="~/css/admin.css" />

<h2>⚙️ 系统设置</h2>

<ul class="admin-tabs">
    <li class="tab-active"><a asp-page="/Admin/Index">房间管理</a></li>
    <li><a asp-page="/Admin/Users">账号管理</a></li>
</ul>

@if (Model.SaveSuccess)
{
    <div class="alert alert-success">✅ 修改已保存</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">❌ @Model.ErrorMessage</div>
}

<h4>房间列表</h4>
<form method="post">
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th style="width:80px;">房号</th>
                <th style="width:120px;">类型</th>
                <th style="width:120px;">单价 (元/晚)</th>
                <th>状态</th>
                <th>卫生</th>
                <th style="width:60px;">操作</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Rooms.Count; i++)
            {
                var roomNum = Model.Rooms[i].RoomNumber;
                <tr>
                    <td><b>@roomNum</b></td>
                    <td>
                        <select asp-for="Rooms[i].RoomType" class="form-control" style="width:100px;">
                            <option value="Single">单间</option>
                            <option value="Double">标间</option>
                            <option value="Suite">套房</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="Rooms[i].Price" class="form-control" style="width:100px;" />
                    </td>
                    <td>@(Model.Rooms[i].Status switch { "Available" => "空闲", "Booked" => "已预订", "Occupied" => "入住中", _ => Model.Rooms[i].Status })</td>
                    <td>@(Model.Rooms[i].CleanStatus == "Clean" ? "干净" : "待清扫")</td>
                    <td>
                        @if (Model.Rooms[i].Status == "Available")
                        {
                            <button type="submit" asp-page-handler="DeleteRoom" asp-route-roomNumber="@roomNum"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('确认删除 '+@roomNum+' 号房间？')">删除</button>
                        }
                    </td>
                </tr>
                <input type="hidden" asp-for="Rooms[i].RoomNumber" />
                <input type="hidden" asp-for="Rooms[i].Status" />
                <input type="hidden" asp-for="Rooms[i].CleanStatus" />
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">保存修改</button>
</form>

<hr />
<h4>添加新房间</h4>
<form method="post" asp-page-handler="AddRoom" class="row g-3">
    <div class="col-auto">
        <input name="roomNumber" class="form-control" placeholder="房号，如 401" required />
    </div>
    <div class="col-auto">
        <select name="roomType" class="form-control">
            <option value="Single">单间</option>
            <option value="Double">标间</option>
            <option value="Suite">套房</option>
        </select>
    </div>
    <div class="col-auto">
        <input name="price" type="number" class="form-control" placeholder="价格" value="200" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-success">添加房间</button>
    </div>
</form>
